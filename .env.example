# Public browser configuration. Do not put credentials or tokens here.
VITE_API_BASE_URL=https://api.bewhere.com

# Server-only AI settings. Never prefix secrets with VITE_.
# Set in .env.local or the server process environment, then restart Vite.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional local CSV directory. Defaults to .data/ in the project; never public/.
AUTOLOOP_DATA_DIR=.data
